{
  "version": 1,
  "id": "splash",
  "name": "Splash",
  "description": "Experimental catalog for splash and hero-style landing surfaces.",
  "props": {
    "locale": {
      "type": "string",
      "description": "Current locale for copy and formatting.",
      "default": "en-US"
    }
  },
  "contexts": {
    "scene": {
      "title": "Scene",
      "description": "Shared splash scene/session context available to items.",
      "state": {
        "loggedIn": {
          "type": "boolean",
          "description": "Whether the current scene viewer is logged in.",
          "default": false
        },
        "username": {
          "type": "string",
          "description": "Display name for the logged-in viewer."
        }
      },
      "actions": {
        "login": {
          "title": "Login",
          "description": "Updates authentication state for the current viewer.",
          "props": {
            "username": {
              "type": "string",
              "required": true,
              "description": "Display username."
            }
          }
        },
        "logout": {
          "title": "Logout",
          "description": "Clears authentication state for the current viewer.",
          "props": {}
        },
        "openUrl": {
          "title": "Open URL",
          "description": "Requests navigation to a URL selected from a splash call to action.",
          "props": {
            "url": {
              "type": "string",
              "required": true,
              "description": "Destination URL."
            },
            "target": {
              "type": "string",
              "description": "Navigation target hint.",
              "enum": ["self", "blank"],
              "default": "self"
            }
          }
        }
      }
    },
    "theme": {
      "title": "Theme",
      "description": "Active theme context projected from the catalog theme contract and concrete theme instances.",
      "state": {
        "name": {
          "type": "string",
          "description": "Current active theme name.",
          "enum": ["light", "dark"],
          "default": "light"
        }
      },
      "actions": {
        "setTheme": {
          "title": "Set Theme",
          "description": "Updates the active theme context.",
          "props": {
            "name": {
              "type": "string",
              "required": true,
              "enum": ["light", "dark"],
              "description": "Theme name to activate."
            }
          }
        }
      }
    }
  },
  "themes": {
    "default": "light",
    "available": ["light", "dark"]
  },
  "items": ["Hero", "CallToAction", "Background", "Stack", "Counter", "Modal", "BetaSignupForm", "AuthButton", "ThemePicker", "SnakeGame"]
}
