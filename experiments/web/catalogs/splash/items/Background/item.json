{
  "version": 1,
  "title": "Background",
  "description": "Decorative background configuration for splash surfaces.",
  "kind": "component",
  "props": {
    "kind": {
      "type": "string",
      "description": "Background rendering mode.",
      "enum": ["solid", "gradient", "image"],
      "default": "solid"
    },
    "color": {
      "type": "string",
      "description": "Solid color or primary gradient color."
    },
    "accentColor": {
      "type": "string",
      "description": "Secondary color for gradient-like backgrounds."
    },
    "imageUrl": {
      "type": "string",
      "description": "Image URL when kind is `image`."
    },
    "overlay": {
      "type": "string",
      "description": "Optional overlay strength for improving foreground contrast.",
      "enum": ["none", "light", "dark"],
      "default": "none"
    }
  },
  "state": {
    "elapsedMs": {
      "type": "number",
      "description": "Elapsed animation time in milliseconds.",
      "default": 0
    },
    "phase": {
      "type": "number",
      "description": "Normalized animation phase from 0 to 1.",
      "default": 0
    }
  },
  "slots": {},
  "actions": {
    "advance": {
      "title": "Advance",
      "description": "Advances decorative background animation state.",
      "props": {
        "deltaMs": { "type": "number", "required": true }
      }
    }
  },
  "events": {}
}
